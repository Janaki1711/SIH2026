<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:padding="14dp">

    <!-- Header / Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="iTANTRA NEURAL TTS &amp; SOS"
        android:textColor="#00E5FF"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ISRO SIH26173 | 10 Indian Languages Neural Transceiver"
        android:textColor="#90A4AE"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Mode Selector: Walkie-Talkie vs Phone -->
    <RadioGroup
        android:id="@+id/rgMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <RadioButton
            android:id="@+id/rbWalkieTalkie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Walkie-Talkie (PTT)"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbPhoneMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Phone (Full-Duplex)"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- Language Selector Dropdown -->
    <TextView
        android:id="@+id/tvLangLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select from 10 Indian Languages:"
        android:textColor="#CFD8DC"
        android:textSize="12sp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/rgMode"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinnerLanguage"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#1C2331"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvLangLabel" />

    <!-- Input text for speech synthesis -->
    <EditText
        android:id="@+id/etSpeechText"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="#161B22"
        android:gravity="top|start"
        android:hint="Type custom text in any of the 10 languages..."
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#546E7A"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerLanguage" />

    <!-- Presets Header -->
    <TextView
        android:id="@+id/tvPresetsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quick Language Presets (All 10):"
        android:textColor="#90A4AE"
        android:textSize="11sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/etSpeechText"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Row 1 of Presets: HI, TA, TE, KN, ML -->
    <LinearLayout
        android:id="@+id/llPresetsRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvPresetsLabel">

        <Button
            android:id="@+id/btnPresetHi"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="HI"
            android:textSize="10sp"
            android:backgroundTint="#263238"
            android:textColor="#00E5FF" />

        <Button
            android:id="@+id/btnPresetTa"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="TA"
            android:textSize="10sp"
            android:backgroundTint="#263238"
            android:textColor="#00E5FF" />

        <Button
            android:id="@+id/btnPresetTe"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="TE"
            android:textSize="10sp"
            android:backgroundTint="#263238"
            android:textColor="#00E5FF" />

        <Button
            android:id="@+id/btnPresetKn"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="KN"
            android:textSize="10sp"
            android:backgroundTint="#263238"
            android:textColor="#00E5FF" />

        <Button
            android:id="@+id/btnPresetMl"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="ML"
            android:textSize="10sp"
            android:backgroundTint="#263238"
            android:textColor="#00E5FF" />
    </LinearLayout>

    <!-- Row 2 of Presets: MR, GU, BN, OR, EN -->
    <LinearLayout
        android:id="@+id/llPresetsRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/llPresetsRow1">

        <Button
            android:id="@+id/btnPresetMr"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="MR"
            android:textSize="10sp"
            android:backgroundTint="#263238"
            android:textColor="#00E5FF" />

        <Button
            android:id="@+id/btnPresetGu"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="GU"
            android:textSize="10sp"
            android:backgroundTint="#263238"
            android:textColor="#00E5FF" />

        <Button
            android:id="@+id/btnPresetBn"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="BN"
            android:textSize="10sp"
            android:backgroundTint="#263238"
            android:textColor="#00E5FF" />

        <Button
            android:id="@+id/btnPresetOr"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="OR"
            android:textSize="10sp"
            android:backgroundTint="#263238"
            android:textColor="#00E5FF" />

        <Button
            android:id="@+id/btnPresetEn"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="EN"
            android:textSize="10sp"
            android:backgroundTint="#263238"
            android:textColor="#00E5FF" />
    </LinearLayout>

    <!-- Telemetry Box -->
    <LinearLayout
        android:id="@+id/llTelemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#161B22"
        android:padding="6dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/llPresetsRow2">

        <TextView
            android:id="@+id/tvTransceiverState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATE: HALF-DUPLEX (PTT READY)"
            android:textColor="#00E676"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPayloadSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAYLOAD: 40 BYTES (2000x COMPRESSION)"
            android:textColor="#90A4AE"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvLatency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LATENCY: &lt; 15ms"
            android:textColor="#90A4AE"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/llActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/llTelemetry">

        <Button
            android:id="@+id/btnPlayAudio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="PLAY SPEECH (RX PLAYBACK)"
            android:textColor="#0B0E14"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#00E676" />

        <Button
            android:id="@+id/btnPttTalk"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="HOLD TO TRANSMIT (PTT)"
            android:textColor="#0B0E14"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#00E5FF" />

        <Button
            android:id="@+id/btnEmergencySos"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="EMERGENCY SOS OVERRIDE (100% VOL)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#FF3D00" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

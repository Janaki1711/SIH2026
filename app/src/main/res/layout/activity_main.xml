<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:padding="16dp">

    <!-- Header / Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="iTANTRA NEURAL TTS &amp; SOS"
        android:textColor="#00E5FF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ISRO Problem Statement SIH26173 | Subsystem 4"
        android:textColor="#90A4AE"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Mode Selector: Walkie-Talkie vs Phone -->
    <RadioGroup
        android:id="@+id/rgMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <RadioButton
            android:id="@+id/rbWalkieTalkie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Walkie-Talkie (PTT)"
            android:textColor="#FFFFFF" />

        <RadioButton
            android:id="@+id/rbPhoneMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Phone (Full-Duplex)"
            android:textColor="#FFFFFF" />
    </RadioGroup>

    <!-- Language Selector -->
    <TextView
        android:id="@+id/tvLangLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Target Indic Language:"
        android:textColor="#CFD8DC"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/rgMode"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinnerLanguage"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1C2331"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvLangLabel" />

    <!-- Input text for speech synthesis -->
    <EditText
        android:id="@+id/etSpeechText"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#161B22"
        android:gravity="top|start"
        android:hint="Enter text to synthesize or transmit..."
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#546E7A"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerLanguage" />

    <!-- Presets -->
    <LinearLayout
        android:id="@+id/llPresets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/etSpeechText">

        <Button
            android:id="@+id/btnPresetHi"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="HI"
            android:textSize="11sp"
            android:backgroundTint="#263238"
            android:textColor="#00E5FF" />

        <Button
            android:id="@+id/btnPresetTa"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="TA"
            android:textSize="11sp"
            android:backgroundTint="#263238"
            android:textColor="#00E5FF" />

        <Button
            android:id="@+id/btnPresetTe"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="TE"
            android:textSize="11sp"
            android:backgroundTint="#263238"
            android:textColor="#00E5FF" />

        <Button
            android:id="@+id/btnPresetEn"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="EN"
            android:textSize="11sp"
            android:backgroundTint="#263238"
            android:textColor="#00E5FF" />
    </LinearLayout>

    <!-- Telemetry Box -->
    <LinearLayout
        android:id="@+id/llTelemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#161B22"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/llPresets">

        <TextView
            android:id="@+id/tvTransceiverState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATE: HALF-DUPLEX (PTT READY)"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPayloadSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAYLOAD: 40 BYTES (2000x COMPRESSION)"
            android:textColor="#90A4AE"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvLatency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LATENCY: &lt; 15ms"
            android:textColor="#90A4AE"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- PTT Button -->
    <Button
        android:id="@+id/btnPttTalk"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="HOLD TO TRANSMIT (PTT)"
        android:textColor="#0B0E14"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#00E5FF"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/llTelemetry" />

    <!-- Emergency SOS Override Button -->
    <Button
        android:id="@+id/btnEmergencySos"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="EMERGENCY SOS OVERRIDE (100% VOL)"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#FF3D00"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnPttTalk" />

</androidx.constraintlayout.widget.ConstraintLayout>

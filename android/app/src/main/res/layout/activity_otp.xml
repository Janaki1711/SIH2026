<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F8FAFC"
    android:paddingHorizontal="28dp" android:gravity="center_vertical">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Verify your number" android:textSize="22sp" android:textStyle="bold"
        android:textColor="#0F172A" android:layout_marginBottom="8dp"/>

    <TextView android:id="@+id/otpPhoneLabel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="OTP sent to your number"
        android:textSize="14sp" android:textColor="#64748B" android:layout_marginBottom="24dp"/>

    <TextView android:id="@+id/otpDevHint" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="#FEF3C7"
        android:textColor="#92400E" android:textSize="12sp" android:textStyle="bold"
        android:padding="10dp" android:fontFamily="monospace"
        android:layout_marginBottom="16dp" android:visibility="gone"/>

    <EditText android:id="@+id/otpInput" android:layout_width="match_parent"
        android:layout_height="64dp" android:background="@drawable/input_bg"
        android:hint="Enter 6-digit OTP" android:textColorHint="#94A3B8"
        android:textColor="#0F172A" android:textSize="24sp" android:textStyle="bold"
        android:gravity="center" android:inputType="numberPassword" android:maxLength="6"
        android:singleLine="true" android:layout_marginBottom="12dp" android:fontFamily="monospace"/>

    <TextView android:id="@+id/otpError" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#DC2626"
        android:textSize="13sp" android:layout_marginBottom="12dp" android:visibility="gone"/>

    <Button android:id="@+id/otpVerifyBtn" android:layout_width="match_parent"
        android:layout_height="52dp" android:text="VERIFY"
        android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
        android:backgroundTint="#0284C7" android:insetTop="0dp" android:insetBottom="0dp"
        android:layout_marginBottom="10dp"/>

    <Button android:id="@+id/otpResendBtn" android:layout_width="match_parent"
        android:layout_height="44dp" android:text="Resend OTP in 60s"
        android:textColor="#64748B" android:textSize="13sp"
        android:backgroundTint="#F1F5F9" android:insetTop="0dp" android:insetBottom="0dp"
        android:enabled="false"/>

    <ProgressBar android:id="@+id/otpProgress" android:layout_width="36dp"
        android:layout_height="36dp" android:layout_gravity="center"
        android:layout_marginTop="12dp" android:visibility="gone"/>
</LinearLayout>

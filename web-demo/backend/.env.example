# iTantra Backend Configuration — copy to .env and customise
# DO NOT commit .env to version control

# SQLite database file path
DATABASE_URL=itantra.db

# Set to 'production' to enable real CAPTCHA and disable dev_bypass
AUTH_MODE=development

# OTP settings
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

# Session security — CHANGE THIS IN PRODUCTION
SESSION_SECRET=change-this-in-production

# CAPTCHA provider ('development' = no real validation)
# In production, set to 'hcaptcha' or 'recaptcha' and fill in CAPTCHA_SECRET_KEY
# WARNING: Never use captcha_token='dev_bypass' in production
CAPTCHA_PROVIDER=development
CAPTCHA_SECRET_KEY=

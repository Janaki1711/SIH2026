<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F8FAFC"
    android:paddingHorizontal="28dp" android:gravity="center_vertical">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="iTantra" android:textSize="36sp" android:textStyle="bold"
        android:textColor="#0284C7" android:gravity="center" android:layout_marginBottom="6dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="OFFLINE MULTILINGUAL COMMUNICATION"
        android:textSize="10sp" android:textColor="#64748B"
        android:gravity="center" android:letterSpacing="0.1"
        android:fontFamily="monospace" android:layout_marginBottom="40dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Enter your phone number" android:textSize="18sp"
        android:textStyle="bold" android:textColor="#0F172A" android:layout_marginBottom="6dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="We will send you a one-time verification code"
        android:textSize="13sp" android:textColor="#64748B" android:layout_marginBottom="20dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/input_bg" android:layout_marginBottom="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="match_parent"
            android:text="+91" android:textSize="15sp" android:textStyle="bold"
            android:textColor="#0284C7" android:gravity="center" android:paddingHorizontal="14dp"/>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E2E8F0"/>
        <EditText android:id="@+id/loginPhoneInput" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:background="@null" android:hint="10-digit mobile number"
            android:textColorHint="#94A3B8" android:textColor="#0F172A"
            android:textSize="15sp" android:inputType="phone" android:singleLine="true"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Backend server URL" android:textSize="11sp"
        android:textColor="#64748B" android:layout_marginBottom="4dp"/>
    <EditText android:id="@+id/loginServerInput" android:layout_width="match_parent"
        android:layout_height="44dp" android:background="@drawable/input_bg"
        android:textSize="11sp" android:textColor="#0F172A" android:paddingHorizontal="12dp"
        android:singleLine="true" android:fontFamily="monospace" android:layout_marginBottom="16dp"/>

    <TextView android:id="@+id/loginError" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#DC2626"
        android:textSize="13sp" android:layout_marginBottom="10dp" android:visibility="gone"/>

    <Button android:id="@+id/loginContinueBtn" android:layout_width="match_parent"
        android:layout_height="52dp" android:text="CONTINUE"
        android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
        android:backgroundTint="#0284C7" android:insetTop="0dp" android:insetBottom="0dp"/>

    <ProgressBar android:id="@+id/loginProgress" android:layout_width="36dp"
        android:layout_height="36dp" android:layout_gravity="center"
        android:layout_marginTop="12dp" android:visibility="gone"/>
</LinearLayout>

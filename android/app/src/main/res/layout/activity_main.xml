<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F8FAFC"
    tools:context=".MainActivity">

    <!-- ═══════════════════════════════════════════════
         MAIN CONTENT
         ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- ── 1. TOP HEADER ──────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/headerLogo"
                android:layout_width="110dp"
                android:layout_height="34dp"
                android:scaleType="fitStart"
                android:src="@drawable/logo_itantra"
                android:contentDescription="iTantra Logo" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <!-- Peer status pill (tap to open diagnostics) -->
            <LinearLayout
                android:id="@+id/netStatusText"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/pill_green_bg"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/statusDotHeader"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_grey"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/statusDotText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Searching..."
                    android:textColor="#065F46"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:maxWidth="100dp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="LOGOUT"
                android:textColor="#0369A1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:backgroundTint="#E0F2FE"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </LinearLayout>

        <!-- ── 2. MAIN SCROLLABLE CONTENT ─────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp">

            <!-- Language + Peer Chip Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_white_rounded"
                android:padding="8dp"
                android:layout_marginBottom="6dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MY LANG:"
                    android:textColor="#0284C7"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <Spinner
                    android:id="@+id/langSpinner"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1" />

                <!-- Peer Chip → tap to open diagnostics -->
                <LinearLayout
                    android:id="@+id/peerChip"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/pill_peer_sky"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/peerDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/dot_grey"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/peerNodeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NO PEER"
                        android:textColor="#0369A1"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>

            <!-- Peer Selector Row (replaces IP input) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_white_rounded"
                android:padding="6dp"
                android:layout_marginBottom="6dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEND TO:"
                    android:textColor="#0284C7"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <Spinner
                    android:id="@+id/peerSelectSpinner"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnRefreshPeers"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="⟳ SCAN"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:backgroundTint="#0284C7"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <!-- Hidden — kept for diagnostics sheet CONNECT button compatibility -->
                <EditText
                    android:id="@+id/peerIpInput"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/btnConnectPeer"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    android:text="." />
            </LinearLayout>

            <!-- Channel Lock Banner -->
            <LinearLayout
                android:id="@+id/channelLockBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FEF3C7"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/channelLockText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎙️ Receiving transmission... Channel busy"
                    android:textColor="#92400E"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Chat area — fills remaining space -->
            <ScrollView
                android:id="@+id/chatScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:background="@drawable/card_white_rounded"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/chatMessageContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔒 Encrypted Multilingual Mesh Active\nConnect to a peer and tap 🎙️ TAP TO SPEAK"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="20dp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- ── 3. BOTTOM CONTROLS ──────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:elevation="8dp">

            <!-- PTT State Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <View
                    android:id="@+id/pttStateDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_grey"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/pttStateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="IDLE — Tap mic to speak"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rttValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RTT: —"
                    android:textColor="#0284C7"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- PTT Button — TAP TO SPEAK (toggle) -->
            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="🎙️  TAP TO SPEAK"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:background="@drawable/ptt_btn_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginBottom="8dp" />

            <!-- Text input row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/input_bg">

                <EditText
                    android:id="@+id/customMsgInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Type message in any language..."
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:singleLine="true"
                    android:imeOptions="actionSend" />

                <Button
                    android:id="@+id/btnSendCustom"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:text="→"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:backgroundTint="#0284C7"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════
         DIAGNOSTICS SHEET — slides up on peerChip tap
         ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/diagSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#B0000000"
        android:visibility="gone"
        android:fitsSystemWindows="true">

        <!-- Tap outside to close -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true" />

        <!-- Sheet card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/sheet_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- Title row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📡 Mesh Config &amp; Diagnostics"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCloseDiag"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="✕"
                    android:textColor="#0369A1"
                    android:textSize="13sp"
                    android:backgroundTint="#E0F2FE"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>

            <!-- Peer IP + Ping + Connect -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/diagPeerIpInput"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/input_bg"
                    android:hint="Peer IP  (e.g. 10.163.x.x)"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="12sp"
                    android:inputType="text"
                    android:singleLine="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <Button
                    android:id="@+id/btnDiagPing"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="PING"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="#0EA5E9"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <Button
                    android:id="@+id/btnDiagConnect"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="CONNECT"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="#16A34A"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>

            <!-- Live metrics: 4 chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/chip_metric_bg" android:padding="8dp" android:layout_marginEnd="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="RAM" android:textColor="#64748B" android:textSize="9sp" />
                    <TextView android:id="@+id/diagRam" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—" android:textColor="#0F172A"
                        android:textSize="13sp" android:textStyle="bold" android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/chip_metric_bg" android:padding="8dp" android:layout_marginEnd="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="BATTERY" android:textColor="#64748B" android:textSize="9sp" />
                    <TextView android:id="@+id/diagBattery" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—%" android:textColor="#059669"
                        android:textSize="13sp" android:textStyle="bold" android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/chip_metric_bg" android:padding="8dp" android:layout_marginEnd="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="TX / RX" android:textColor="#64748B" android:textSize="9sp" />
                    <TextView android:id="@+id/diagTxRx" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0/0" android:textColor="#0F172A"
                        android:textSize="13sp" android:textStyle="bold" android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/chip_metric_bg" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="CARRIER" android:textColor="#64748B" android:textSize="9sp" />
                    <TextView android:id="@+id/diagCarrier" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="WI-FI" android:textColor="#0284C7"
                        android:textSize="13sp" android:textStyle="bold" android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>

            <!-- Second row: CPU, Payload, Airtime -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/chip_metric_bg" android:padding="8dp" android:layout_marginEnd="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="CPU" android:textColor="#64748B" android:textSize="9sp" />
                    <TextView android:id="@+id/diagCpu" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—" android:textColor="#0F172A"
                        android:textSize="13sp" android:textStyle="bold" android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/chip_metric_bg" android:padding="8dp" android:layout_marginEnd="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PAYLOAD" android:textColor="#64748B" android:textSize="9sp" />
                    <TextView android:id="@+id/diagPayload" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="— B" android:textColor="#0F172A"
                        android:textSize="13sp" android:textStyle="bold" android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/chip_metric_bg" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="RTT" android:textColor="#64748B" android:textSize="9sp" />
                    <TextView android:id="@+id/diagAirtime" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="— ms" android:textColor="#0F172A"
                        android:textSize="13sp" android:textStyle="bold" android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>

            <!-- Live Log -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LIVE LOG"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <View
                    android:id="@+id/diagLiveDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/dot_green" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/diagLogScroll"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/log_bg">

                <TextView
                    android:id="@+id/diagLogText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="> iTantra Diagnostics initializing..."
                    android:textColor="#4ADE80"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
            </ScrollView>

        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════
         HIDDEN STUB VIEWS — IDs used in MainActivity
         Never visible, prevent null crashes
         ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:orientation="vertical">

        <Button android:id="@+id/btnModeWalkieTalkie" android:layout_width="1dp" android:layout_height="1dp" android:text="." />
        <Button android:id="@+id/btnModePhone"        android:layout_width="1dp" android:layout_height="1dp" android:text="." />
        <Button android:id="@+id/testButton"          android:layout_width="1dp" android:layout_height="1dp" android:text="." />
        <Button android:id="@+id/stopButton"          android:layout_width="1dp" android:layout_height="1dp" android:text="." />
        <Button android:id="@+id/btnSosAmbulance"     android:layout_width="1dp" android:layout_height="1dp" android:text="." />
        <Button android:id="@+id/btnSosFlood"         android:layout_width="1dp" android:layout_height="1dp" android:text="." />
        <Button android:id="@+id/btnSosFire"          android:layout_width="1dp" android:layout_height="1dp" android:text="." />
        <Button android:id="@+id/btnSosUrgent"        android:layout_width="1dp" android:layout_height="1dp" android:text="." />
        <Button android:id="@+id/btnStartAudio"       android:layout_width="1dp" android:layout_height="1dp" android:text="." />
        <Button android:id="@+id/btnStopTranscribe"   android:layout_width="1dp" android:layout_height="1dp" android:text="." />
        <TextView android:id="@+id/txMessageText"  android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/txLangLabel"    android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/txTimeLabel"    android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/rxLangLabel"    android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/rxTimeLabel"    android:layout_width="1dp" android:layout_height="1dp" />
        <!-- telemetry hidden (data goes to diag panel only) -->
        <TextView android:id="@+id/telemetryCpu"     android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/telemetryRam"     android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/telemetryPower"   android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/telemetryLatency" android:layout_width="1dp" android:layout_height="1dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
